{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux GCC Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "DEBUG": "ON",
        "BUILD_TESTING": "ON",
        "KLEINBOT_USE_BUNDLED_DEPS": "OFF"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux GCC Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "DEBUG": "OFF",
        "BUILD_TESTING": "OFF",
        "KLEINBOT_USE_BUNDLED_DEPS": "OFF"
      }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows MinGW Debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/windows-mingw-debug",
      "cacheVariables": {
        "DEBUG": "ON",
        "BUILD_TESTING": "ON",
        "KLEINBOT_USE_BUNDLED_DEPS": "ON"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW Release",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/windows-mingw-release",
      "cacheVariables": {
        "DEBUG": "OFF",
        "BUILD_TESTING": "OFF",
        "KLEINBOT_USE_BUNDLED_DEPS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "jobs": 2
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "jobs": 2
    },
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug",
      "jobs": 2
    },
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
